# Database Connections
DATABASE_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
SUPABASE_DATABASE_URL=

# AI & LLM Service
GEMINI_API_KEY=

# -------------------------------------------------------------
# EMAIL SERVICES (SMTP / Resend) FOR OTP & NOTIFICATIONS
# -------------------------------------------------------------

# Option A: Resend API (Recommended for modern transactional email)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=Code Point Kenya <admissions@codepointkenya.ac.ke>

# Option B: Standard SMTP (Gmail, Outlook, Amazon SES, SendGrid, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Code Point Kenya" <noreply@codepointkenya.ac.ke>

# -------------------------------------------------------------
# SMS GATEWAYS (Africa's Talking / Twilio) FOR 6-DIGIT OTP
# -------------------------------------------------------------

# Option A: Africa's Talking (Premier SMS Gateway for Kenya & East Africa +254)
# Sign up at https://africastalking.com (Use 'sandbox' as username for testing)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=CODEPOINT

# Option B: Twilio SMS (Global SMS Gateway)
# Obtain from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# -------------------------------------------------------------
# OTP SETTINGS
# -------------------------------------------------------------
OTP_EXPIRY_MINUTES=10
APP_NAME=Code Point Kenya
